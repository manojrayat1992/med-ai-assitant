{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Marketing site only — medaiclinical.com. This is NOT the application; the app runs on AWS
  // at app.medaiclinical.com and is deployed by the GitHub Actions pipeline.
  //
  // Without this file, `wrangler deploy` guessed `frontend` as the asset directory and published
  // the entire React source tree — every .tsx, tsconfig, package.json — as publicly fetchable
  // files. No secrets were in it, but it served source instead of a website and gave away the
  // internal structure for nothing.
  "name": "med-ai-assitant",
  "compatibility_date": "2026-08-20",

  "assets": {
    // Plain static HTML. No build step, which is why there is no build command.
    // _headers and _redirects inside this directory are honoured by Workers static assets.
    "directory": "marketing",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true
  },

  "routes": [
    { "pattern": "medaiclinical.com", "custom_domain": true },
    { "pattern": "www.medaiclinical.com", "custom_domain": true }
  ],

  // Off on purpose. With these on, the entire medical-brand marketing site is also served from
  // *.workers.dev URLs. A second, identical copy of a healthcare brand on a generic shared
  // subdomain is a lookalike-site signal to Google Safe Browsing, and it splits SEO for nothing.
  "workers_dev": false,
  "preview_urls": false,

  "main": "worker/index.js",

  "vars": {
    "CONTACT_TO": "hello@medaiclinical.com",
    "CONTACT_FROM": "hello@medaiclinical.com",
    "CONTACT_FROM_NAME": "Med-AI Clinical Website"
  },

  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "hello@medaiclinical.com",
      "allowed_sender_addresses": ["hello@medaiclinical.com"]
    }
  ]
}
